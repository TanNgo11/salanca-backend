{
  "collectionName": "components_shared_social_links",
  "info": {
    "displayName": "Social Link",
    "description": "A named social channel and URL"
  },
  "options": {},
  "attributes": {
    "platform": {
      "type": "enumeration",
      "enum": ["facebook", "instagram", "tiktok", "youtube", "other"],
      "required": true
    },
    "label": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "string",
      "required": true,
      "maxLength": 80
    },
    "url": {
      "type": "string",
      "required": true,
      "maxLength": 500
    }
  }
}
