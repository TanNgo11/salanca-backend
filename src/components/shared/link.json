{
  "collectionName": "components_shared_links",
  "info": {
    "displayName": "Link",
    "description": "A labeled internal or external link"
  },
  "options": {},
  "attributes": {
    "label": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "string",
      "required": true,
      "maxLength": 80
    },
    "url": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "string",
      "required": true,
      "maxLength": 500
    },
    "openInNewTab": {
      "type": "boolean",
      "default": false,
      "required": true
    }
  }
}
