{
  "kind": "singleType",
  "collectionName": "home_pages",
  "info": {
    "singularName": "home-page",
    "pluralName": "home-pages",
    "displayName": "Trang chủ",
    "description": "Eight mockup sections: hero, experience, buffet, menu, story, process, space, booking"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "hero": {
      "pluginOptions": { "i18n": { "localized": true } },
      "type": "component",
      "component": "home.hero",
      "repeatable": false,
      "required": true
    },
    "experience": {
      "pluginOptions": { "i18n": { "localized": true } },
      "type": "component",
      "component": "home.experience",
      "repeatable": false
    },
    "buffet": {
      "pluginOptions": { "i18n": { "localized": true } },
      "type": "component",
      "component": "home.buffet",
      "repeatable": false
    },
    "featuredPackage": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::menu-package.menu-package"
    },
    "menuHighlights": {
      "pluginOptions": { "i18n": { "localized": true } },
      "type": "component",
      "component": "home.menu-highlights",
      "repeatable": false
    },
    "featuredMenuItems": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::menu-item.menu-item"
    },
    "story": {
      "pluginOptions": { "i18n": { "localized": true } },
      "type": "component",
      "component": "home.story",
      "repeatable": false
    },
    "process": {
      "pluginOptions": { "i18n": { "localized": true } },
      "type": "component",
      "component": "home.process",
      "repeatable": false
    },
    "space": {
      "pluginOptions": { "i18n": { "localized": true } },
      "type": "component",
      "component": "home.space",
      "repeatable": false
    },
    "bookingStrip": {
      "pluginOptions": { "i18n": { "localized": true } },
      "type": "component",
      "component": "shared.cta",
      "repeatable": false,
      "required": true
    },
    "seo": {
      "pluginOptions": { "i18n": { "localized": true } },
      "type": "component",
      "component": "shared.seo",
      "repeatable": false,
      "required": true
    }
  }
}
