{
  "kind": "collectionType",
  "collectionName": "menu_packages",
  "info": {
    "singularName": "menu-package",
    "pluralName": "menu-packages",
    "displayName": "Menu Package",
    "description": "Buffet or fixed menu package"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "string",
      "required": true,
      "maxLength": 140
    },
    "slug": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "description": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "blocks"
    },
    "adultPrice": {
      "type": "decimal",
      "required": true,
      "min": 0
    },
    "childPrice": {
      "type": "decimal",
      "min": 0
    },
    "includedItems": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "component",
      "component": "shared.list-item",
      "repeatable": true
    },
    "image": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "component",
      "component": "shared.image",
      "repeatable": false
    },
    "isFeatured": {
      "type": "boolean",
      "required": true,
      "default": false
    },
    "isActive": {
      "type": "boolean",
      "required": true,
      "default": true
    },
    "displayOrder": {
      "type": "integer",
      "required": true,
      "default": 0,
      "min": 0
    },
    "seo": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    }
  }
}
