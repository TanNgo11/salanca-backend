        }
      },
      "galleryItems": {
        "edit": {
          "label": "Mục gallery liên kết"
        },
        "list": {
          "label": "Mục gallery liên kết"
        }
      },
      "isActive": {
        "edit": {
          "label": "Đang hoạt động"
        },
        "list": {
          "label": "Đang hoạt động"
        }
      },
      "displayOrder": {
        "edit": {
          "label": "Thứ tự hiển thị"
        },
        "list": {
          "label": "Thứ tự hiển thị"
        }
      },
      "seo": {
