{
  "kind": "collectionType",
  "collectionName": "locations",
  "info": {
    "singularName": "location",
    "pluralName": "locations",
    "displayName": "Chi nhánh",
    "description": "Chi nhánh nhà hàng và giờ hoạt động"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "string",
      "required": true,
      "maxLength": 140
    },
    "slug": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "address": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "text",
      "required": true,
      "maxLength": 500
    },
    "mapUrl": {
      "type": "text",
      "maxLength": 4096
    },
    "phone": {
      "type": "string",
      "maxLength": 40
    },
    "email": {
      "type": "email"
    },
    "operatingHours": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "component",
      "component": "shared.operating-period",
      "repeatable": true
    },
    "heroImage": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "component",
      "component": "shared.image",
      "repeatable": false
    },
    "gallery": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "component",
      "component": "shared.image",
      "repeatable": true
    },
    "galleryItems": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::gallery-item.gallery-item",
      "mappedBy": "location"
    },
    "isActive": {
      "type": "boolean",
      "required": true,
      "default": true
    },
    "displayOrder": {
      "type": "integer",
      "required": true,
      "default": 0,
      "min": 0
    },
    "seo": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    }
  },
  "config": {
    "metadatas": {
      "name": {
        "edit": {
          "label": "Tên chi nhánh",
          "placeholder": "Salanca Brazil Hà Nội"
        },
        "list": {
          "label": "Tên chi nhánh"
        }
      },
      "slug": {
        "edit": {
          "label": "Slug URL"
        },
        "list": {
          "label": "Slug URL"
        }
      },
      "address": {
        "edit": {
          "label": "Địa chỉ",
          "placeholder": "49 Phan Bội Châu, phường Cửa Nam, TP. Hà Nội"
        },
        "list": {
          "label": "Địa chỉ"
        }
      },
      "mapUrl": {
        "edit": {
          "label": "Link Google Maps"
        },
        "list": {
          "label": "Link Google Maps"
        }
      },
      "phone": {
        "edit": {
          "label": "Điện thoại đặt bàn",
          "placeholder": "02438455224"
        },
        "list": {
          "label": "Điện thoại đặt bàn"
        }
      },
      "email": {
        "edit": {
          "label": "Email",
          "placeholder": "booking@salanca.com.vn"
        },
        "list": {
          "label": "Email"
        }
      },
      "operatingHours": {
        "edit": {
          "label": "Giờ hoạt động"
        },
        "list": {
          "label": "Giờ hoạt động"
        }
      },
      "heroImage": {
