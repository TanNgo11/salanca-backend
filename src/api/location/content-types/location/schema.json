{
  "kind": "collectionType",
  "collectionName": "locations",
  "info": {
    "singularName": "location",
    "pluralName": "locations",
    "displayName": "Location",
    "description": "Restaurant branch and operating information"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "string",
      "required": true,
      "maxLength": 140
    },
    "slug": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "address": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "text",
      "required": true,
      "maxLength": 500
    },
    "mapUrl": {
      "type": "string",
      "maxLength": 500
    },
    "phone": {
      "type": "string",
      "maxLength": 40
    },
    "email": {
      "type": "email"
    },
    "operatingHours": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "component",
      "component": "shared.operating-period",
      "repeatable": true
    },
    "heroImage": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "component",
      "component": "shared.image",
      "repeatable": false
    },
    "gallery": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "component",
      "component": "shared.image",
      "repeatable": true
    },
    "galleryItems": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::gallery-item.gallery-item",
      "mappedBy": "location"
    },
    "isActive": {
      "type": "boolean",
      "required": true,
      "default": true
    },
    "displayOrder": {
      "type": "integer",
      "required": true,
      "default": 0,
      "min": 0
    },
    "seo": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    }
  }
}
