{
  "kind": "singleType",
  "collectionName": "global_settings",
  "info": {
    "singularName": "global-setting",
    "pluralName": "global-settings",
    "displayName": "Cấu hình chung",
    "description": "Thương hiệu, điều hướng, liên hệ và footer dùng toàn site"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "brandName": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "string",
      "required": true,
      "maxLength": 120
    },
    "tagline": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "string",
      "maxLength": 180
    },
    "logo": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "component",
      "component": "shared.image",
      "repeatable": false
    },
    "hotline": {
      "type": "string",
      "required": true,
      "maxLength": 40
    },
    "email": {
      "type": "email",
      "required": true
    },
    "address": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "text",
      "required": true,
      "maxLength": 500
    },
    "mapUrl": {
      "type": "text",
      "maxLength": 2048
    },
    "openingHours": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "component",
      "component": "shared.operating-period",
      "repeatable": true
    },
    "socialLinks": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "component",
      "component": "shared.social-link",
      "repeatable": true
    },
    "headerLinks": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "component",
      "component": "shared.link",
      "repeatable": true
    },
    "footerExploreLinks": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "component",
      "component": "shared.link",
      "repeatable": true
    },
    "footerInfoLinks": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "component",
      "component": "shared.link",
      "repeatable": true
    },
    "mainLocation": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::location.location"
    },
    "defaultSeo": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "component",
      "component": "shared.seo",
      "repeatable": false,
      "required": true
    }
  },
