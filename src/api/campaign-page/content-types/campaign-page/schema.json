{
  "kind": "singleType",
  "collectionName": "campaign_pages",
  "info": {
    "singularName": "campaign-page",
    "pluralName": "campaign-pages",
    "displayName": "Trang ưu đãi",
    "description": "Headings and featured content for promotions and events"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "hero": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "component",
      "component": "shared.hero",
      "repeatable": false,
      "required": true
    },
    "featuredHeading": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "string",
      "required": true,
      "maxLength": 180
    },
    "featuredCampaign": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::campaign.campaign"
    },
    "listingHeading": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "string",
      "required": true,
      "maxLength": 180
    },
    "eventCta": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "component",
      "component": "shared.cta",
      "repeatable": false
    },
    "closingCta": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "component",
      "component": "shared.cta",
      "repeatable": false,
      "required": true
    },
    "seo": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "component",
      "component": "shared.seo",
      "repeatable": false,
      "required": true
    }
  }
}
