HOST=0.0.0.0
PORT=1337

# Generate unique random values for every environment. Never reuse these placeholders.
# pnpm run generate:secrets
APP_KEYS=replace-key-1,replace-key-2,replace-key-3,replace-key-4
API_TOKEN_SALT=replace-with-random-value
ADMIN_JWT_SECRET=replace-with-random-value
TRANSFER_TOKEN_SALT=replace-with-random-value
JWT_SECRET=replace-with-random-value
ENCRYPTION_KEY=replace-with-random-value
AUDIT_IDENTIFIER_HASH_SECRET=replace-with-random-value

# Versioned REST prefix (lowercase segments, no trailing slash).
API_REST_PREFIX=/api/v1

# Comma-separated bare frontend origins for credentialed CORS.
# Defaults to http://localhost:3000 when unset.
FRONTEND_URLS=http://localhost:3000

# Optional refresh-session cookie tuning (Users & Permissions).
# AUTH_COOKIE_NAME=salanca_refresh
# AUTH_COOKIE_SAME_SITE=lax
# AUTH_COOKIE_SECURE=false
# AUTH_COOKIE_DOMAIN=

# PostgreSQL is mandatory. DATABASE_URL may be used by hosted environments;
# otherwise the discrete connection values below are used.
#
# Local default (same machine pattern as batdongsan-cms / backend-bds):
# Windows PostgreSQL on port 5432, user postgres, DB name project-specific.
# Docker Compose alternative: DATABASE_PORT=5433, DATABASE_USERNAME=salanca
# (see compose.yaml) when using `docker compose up -d`.
DATABASE_CLIENT=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=salanca_cms
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=replace-with-local-password
DATABASE_SCHEMA=public
DATABASE_SSL=false
STRAPI_PLUGIN_I18N_INIT_LOCALE_CODE=vi
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT=60000

# Object storage (S3-compatible). When S3_BUCKET is set, all of S3_REGION,
# S3_ROOT_PATH, and CDN_URL are required and local-disk upload is not used.
# Leave S3_BUCKET empty for local Media Library on disk during early development.
# Production (NODE_ENV=production) or MEDIA_STORAGE_MODE=s3 requires S3_BUCKET.
# MEDIA_STORAGE_MODE=
# S3_BUCKET=
# S3_REGION=ap-southeast-1
# S3_ROOT_PATH=uploads
# CDN_URL=https://media.example.com
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false
# S3_ACCESS_KEY_ID=
# S3_ACCESS_SECRET=
# S3_ACL=

# Optional signed CMS webhooks for Next.js revalidation (publish/unpublish).
# Both URL and secret must be set to enable delivery.
# CMS_WEBHOOK_URL=https://www.example.com/api/cms/revalidate
# CMS_WEBHOOK_SECRET=replace-with-random-hmac-secret

# Optional pre-storage WebP processing (editorial-clean only; default off).
# MEDIA_PROCESSING_ENABLED=false
# MEDIA_PROCESSING_MAX_EDGE=2560
# MEDIA_PROCESSING_WEBP_QUALITY=80
# MEDIA_PROCESSING_MAX_INPUT_BYTES=15728640
# MEDIA_PROCESSING_MAX_PIXELS=40000000
# MEDIA_PROCESSING_TIMEOUT_MS=30000
# MEDIA_PROCESSING_CONCURRENCY=2

# Optional Cloudflare Turnstile for public form intake (contact + reservation).
# When unset, verification is skipped (local smoke / early dev).
# When set, POST bodies must include turnstileToken (or cf-turnstile-response).
# Pair with NEXT_PUBLIC_TURNSTILE_SITE_KEY on salanca-web.
# Cloudflare dummy always-pass secret for automated tests:
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# TURNSTILE_SECRET_KEY=

# Per-visitor form rate limiting. Web (server-to-server) sends the visitor IP in
# x-salanca-visitor-ip together with this secret; Strapi trusts the IP only when
# the secret matches. Use the same value as FORM_INTAKE_SHARED_SECRET on salanca-web.
# Unset in production → one site-wide bucket (boot warning). Generate: openssl rand -hex 32
# FORM_INTAKE_SHARED_SECRET=
# Set true when Strapi runs behind a reverse proxy so ctx.request.ip is the real client IP.
# TRUST_PROXY=false
# Form rate limits (defaults: 5 per 600000 ms per IP).
# CONTACT_RATE_LIMIT_MAX=5
# CONTACT_RATE_LIMIT_WINDOW_MS=600000
# RESERVATION_RATE_LIMIT_MAX=5
# RESERVATION_RATE_LIMIT_WINDOW_MS=600000

# Optional transactional email (Resend SMTP via Nodemailer — same pattern as BDS).
# Leave EMAIL_SMTP_HOST empty to disable the email plugin (default for local smoke).
# Local capture (Mailpit etc.): host localhost/127.0.0.1, port 1025, no auth.
# Production / real Resend: EMAIL_SMTP_HOST=smtp.resend.com, USER=resend, KEY=re_...,
#   EMAIL_ALLOW_EXTERNAL_DELIVERY=true outside production, EMAIL_SENDER_DOMAIN required in production.
# FORM_NOTIFY_TO: comma-separated staff inboxes for new contact/reservation leads.
# EMAIL_PROVIDER=nodemailer
# EMAIL_SMTP_HOST=
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_SECURE=false
# EMAIL_SMTP_REQUIRE_TLS=true
# EMAIL_SMTP_USER=resend
# EMAIL_SMTP_KEY=
# EMAIL_FROM_NAME=Salanca
# EMAIL_FROM_ADDRESS=no-reply@example.com
# EMAIL_REPLY_TO=booking@example.com
# EMAIL_SENDER_DOMAIN=example.com
# EMAIL_ALLOW_EXTERNAL_DELIVERY=false
# FORM_NOTIFY_TO is only the default until Admin → "Email thông báo" is saved once.
# FORM_NOTIFY_TO=booking@example.com
# With EMAIL_SMTP_HOST set, guests who leave an email also get a "request received" receipt.


# Online ordering plugin (src/plugins/ordering, docs/plans/ordering-roadmap.md). Off unless true;
# run pnpm run build:ordering (part of build/develop) before enabling.
# ORDERING_ENABLED=false
# AES-256-GCM key for order tokens kept on idempotency records (contracts §21.10). 32 bytes, base64.
# Required when NODE_ENV=production and ordering is enabled; elsewhere order creation refuses
# without it. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ORDERING_ENCRYPTION_KEY=
# Customer order link in emails; {token} goes after '#'. Default: first FRONTEND_URLS + /don-hang#t={token}
# ORDERING_ORDER_LINK_TEMPLATE=https://salanca.vn/don-hang#t={token}
# Order emails reuse the transactional SMTP (EMAIL_SMTP_HOST); staff get them at the branch email.
# Ordering reuses FORM_INTAKE_SHARED_SECRET + x-salanca-visitor-ip for per-visitor rate limits;
# salanca-web must send both headers on server-side calls to /api/v1/ordering/*.
#
# SePay bank transfer. The provider is registered only when SEPAY_WEBHOOK_SECRET is set
# (and ORDERING_ENABLED=true). Boot fails if the secret is set but the token is shorter
# than 16 characters or SEPAY_ACCOUNTS has no account. Secrets stay in env: they are not
# shown in Admin and must not be logged. Webhook URL for SePay:
# https://<cms domain>/api/v1/ordering/webhooks/sepay
# SEPAY_WEBHOOK_SECRET=
# SEPAY_API_TOKEN=
# SEPAY_MEMO_TEMPLATE=SLC{orderCode}
# SEPAY_CAPTURE_MODE=auto
# SEPAY_AMOUNT_TOLERANCE=0
# One JSON object. Each key is an account id. locationRefs is "all" or a list of branch codes.
# accountNumber is digits only, 6–20. Do not commit a real account.
# SEPAY_ACCOUNTS={"q1":{"accountNumber":"000000000001","bankCode":"MBBank","bankName":"MB Bank","accountName":"CONG TY SALANCA","locationRefs":["Q1"]}}
#
# O13 providers — all off by default; enable only after sandbox UAT (docs/providers/*.md).
# ORDERING_PUBLIC_API_URL is required when MoMo or VNPay is enabled: the absolute base of
# THIS cms server used to build IPN/return URLs.
# ORDERING_PUBLIC_API_URL=https://cms.salanca.vn
# Wallet return URLs from the storefront are accepted only on a FRONTEND_URLS origin (https);
# anything else falls back to this server's own return page.
# Paid-channel cap per day and per-message cost hints (VND) for Admin → Kênh thông báo.
# ORDERING_NOTIFY_DAILY_LIMIT=2000
# ORDERING_NOTIFY_COST_ESTIMATES={"sms":900,"zalo":300}
# OTP channels beyond email are opt-in and need the matching provider configured.
# ORDERING_OTP_CHANNELS=email
#
# MoMo AIO v2 (docs/providers/momo.md). IPN URL: <public base>/api/v1/ordering/webhooks/momo
# MOMO_PARTNER_CODE=
# MOMO_ACCESS_KEY=
# MOMO_SECRET_KEY=
# MOMO_ENVIRONMENT=sandbox
# MOMO_REQUEST_TYPE=captureWallet
# MOMO_BASE_URL=            # override — fake servers in tests only
#
# VNPay PAY v2.1.0 (docs/providers/vnpay.md). IPN URL: <public base>/api/v1/ordering/webhooks/vnpay
# VNPAY_TMN_CODE=
# VNPAY_HASH_SECRET=
# VNPAY_ENVIRONMENT=sandbox
# VNPAY_LOCALE=vn
# VNPAY_ORDER_TYPE=other
# VNPAY_CREATE_BY=ordering
# VNPAY_BASE_URL=           # override — fake servers in tests only
#
# Ahamove v3 (docs/providers/ahamove.md). Webhook URL: <public base>/api/v1/ordering/webhooks/ahamove
# AHAMOVE_API_KEY=
# AHAMOVE_MOBILE=           # needed unless AHAMOVE_TOKEN is set (authenticate token)
# AHAMOVE_TOKEN=            # pre-issued bearer token — skips authenticate
# AHAMOVE_WEBHOOK_TOKEN=    # >=16 chars; carrier sends it as the `apikey` header
# AHAMOVE_ENVIRONMENT=staging
# AHAMOVE_SERVICE_ID=SGN-BIKE
# AHAMOVE_PAYMENT_METHOD=CASH
# AHAMOVE_FEE_SOURCE=zone   # zone|carrier — customer fee source on quotes
# AHAMOVE_REQUESTS=[]       # JSON array, e.g. [{"_id":"SGN-BIKE-COD"}]
# AHAMOVE_BASE_URL=         # override — fake servers in tests only
#
# Zalo ZNS (docs/providers/zalo-zns.md). Either a static access token or the OAuth triple.
# ZALO_ACCESS_TOKEN=
# ZALO_APP_ID=
# ZALO_APP_SECRET=
# ZALO_REFRESH_TOKEN=
# ZALO_BASE_URL=            # override — fake servers in tests only
#
# eSMS.vn (docs/providers/sms-esms.md). Brandname required unless ESMS_SMS_TYPE=8.
# ESMS_API_KEY=
# ESMS_SECRET_KEY=
# ESMS_BRANDNAME=
# ESMS_SMS_TYPE=2
# ESMS_IS_UNICODE=true
# ESMS_SANDBOX=false        # 1/test sends are accepted by eSMS but never delivered
# ESMS_CAMPAIGN=
# ESMS_BASE_URL=            # override — fake servers in tests only
